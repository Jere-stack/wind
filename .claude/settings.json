{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "skillOverrides": {
    "docx": "user-invocable-only",
    "pptx": "user-invocable-only",
    "xlsx": "user-invocable-only",
    "pdf": "user-invocable-only",
    "design": "user-invocable-only",
    "dataviz": "user-invocable-only",
    "artifact-design": "user-invocable-only",
    "artifact-diagramming": "user-invocable-only",
    "artifact-capabilities": "user-invocable-only",
    "morning": "user-invocable-only",
    "import-memory": "user-invocable-only",
    "keybindings-help": "user-invocable-only",
    "skill-creator": "user-invocable-only",
    "session-start-hook": "user-invocable-only",
    "update-config": "user-invocable-only",
    "fewer-permission-prompts": "user-invocable-only",
    "claude-api": "user-invocable-only",
    "init": "user-invocable-only",
    "loop": "user-invocable-only"
  },

  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",

      "Bash(npm install)",
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(npm run preview)",
      "Bash(npm run saadata)",
      "Bash(node --check *)",

      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch *)",

      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(sed -n *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)"
    ]
  }
}
